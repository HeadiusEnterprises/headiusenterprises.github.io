<section id="<%= @section_id %>">
  <div class="container">
    <div>
      <pre><code class="highlight"><%= @eyebrow %></code></pre>
      <h2><%= @heading %></h2>
    </div>
    <div class="two-col">
      <% @people.each do |person| %>
        <%= render Card.new do %>
          <pre><code class="highlight"><%= person[:code] %></code></pre>
          <%= markdownify person[:body] %>
        <% end %>
      <% end %>
    </div>
  </div>
</section>
