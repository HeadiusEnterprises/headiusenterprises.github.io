<%= render Section.new(
  section_id: "terms",
  highlighted: false
) do %>
  <%= render CodeBlock.new(
    language: "ruby",
    framed: false
  ) do %>
# == Headius::Support::Terms
# The fine print, kept readable.
  <% end %>
  <%= render Heading.new(
    text: "Terms",
    level: 2
  ) %>
  <%= render DisclosureList.new(
    items: [
      {
        summary: "Billing & Cancellation",
        body: "All subscriptions are billed through Stripe. You can upgrade, downgrade, or cancel at the end of your current billing period. Yearly plans are non-refundable once the billing period has started. If you have questions about billing for your current subscription of Support, please access your billing information at [this link](https://billing.stripe.com/p/login/3cs17H29JgmQ8q4288)."
      },
      {
        summary: "Team Size",
        body: "Professional and Expert plans include up to 5 named email contacts. If your team is larger, contact us — we'll work something out."
      },
      {
        summary: "NDAs",
        body: "We're happy to work under NDA. Subscriptions requiring an NDA will incur a one-time NDA Servicing Fee, billed separately."
      },
      {
        summary: "Enterprise Pricing",
        body: "Enterprise support is customised to your deployment. Pricing may be based on developer hours, CPU units, or other resources depending on your needs. Contact us for a complimentary needs analysis and estimate."
      }
    ]
  ) %>
<% end %>

