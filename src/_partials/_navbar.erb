<nav class="highlight">
  <div class="container">
    <% home = navigation.links[navigation.menus.home] %>
    <% if home %>
      <a href="<%= relative_url home.url %>" class="brand" aria-label="<%= home.label %>">headius<span class="sep">\</span>enterprises</a>
    <% else %>
      <span class="brand">headius<span class="sep">\</span>enterprises</span>
    <% end %>
    <button class="nav-toggle" aria-label="Toggle navigation" onclick="this.closest('nav').querySelector('ul').classList.toggle('open')">
      <span></span><span></span><span></span>
    </button>
    <ul>
      <% navigation.menus.header.each do |id| %>
        <% link = navigation.links[id] %>
        <li><a href="<%= relative_url link.url %>"<%= raw(' aria-current="page"') if resource.relative_url.start_with?(link.url.delete_suffix("/")) %>><%= link.label %></a></li>
      <% end %>
    </ul>
    <div id="theme-switcher">
      <span id="theme-icon" aria-label="Toggle theme">◑</span>
      <menu>
        <li data-theme="auto">◑</li>
        <li data-theme="dark">☽</li>
        <li data-theme="light">☀</li>
        <li data-theme="high-contrast">◉</li>
      </menu>
    </div>
  </div>
</nav>
