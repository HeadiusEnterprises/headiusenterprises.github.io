<section class="highlight" id="<%= @section_id %>">
  <div class="container">
    <div>
      <pre><code class="highlight"><%= @eyebrow %></code></pre>
      <h2><%= @heading %></h2>
    </div>
    <div class="resources-grid">
      <% @articles.each do |article| %>
        <%= render Card.new do %>
          <h3><a href="<%= article[:url] %>" target="_blank" rel="noopener"><%= article[:title] %></a></h3>
          <p class="resource-date"><%= article[:date] %></p>
          <%= markdownify article[:body] %>
        <% end %>
      <% end %>
    </div>
    <% unless @note.to_s.empty? %>
      <%= raw markdownify(@note).sub(/\A<p>/, '<p class="resources-more">') %>
    <% end %>
  </div>
</section>
