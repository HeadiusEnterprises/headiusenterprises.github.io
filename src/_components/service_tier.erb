<section id="<%= @section_id %>"<% if @highlighted %> class="highlight"<% end %>>
  <div class="container">
    <div class="two-col">
      <div>
        <pre><code class="highlight"><%= @code %></code></pre>
        <h2><%= @heading %></h2>
        <%= markdownify @body %>
      </div>
      <%= render Card.new(variant: (@featured ? "featured" : nil)) do %>
        <pre><code class="highlight"><%= @pricing %></code></pre>
        <hr>
        <%= markdownify @features %>
        <% if @actions.any? %>
          <div class="actions">
            <% @actions.each do |action| %>
              <a class="button<%= " ghost" if action[:style] == "ghost" %>" href="<%= action[:url] %>" target="_blank" rel="noopener"><%= action[:label] %></a>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</section>
