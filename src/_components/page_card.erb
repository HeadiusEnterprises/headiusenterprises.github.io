<%= render Card.new do %>
  <% unless @image.to_s.empty? %>
    <img src="<%= @image %>" alt="<%= @image_alt %>" />
  <% end %>
  <h3><%= @title %></h3>
  <%= markdownify(content.to_s.empty? ? @body : content) %>
  <% unless @link_label.to_s.empty? || @link_url.to_s.empty? %>
    <a class="cta" href="<%= url_for @link_url %>"><%= @link_label %></a>
  <% end %>
<% end %>
