<div class="resources-grid">
  <% @articles.each do |article| %>
    <%= render Card.new do %>
      <h3><a href="<%= article[:url] %>" target="_blank" rel="noopener"><%= article[:title] %></a></h3>
      <p class="resource-date"><%= article[:date] %></p>
      <%= markdownify article[:body] %>
    <% end %>
  <% end %>
</div>
