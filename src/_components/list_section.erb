<section id="<%= @section_id %>"<% if @highlighted %> class="highlight"<% end %>>
  <div class="container">
    <div>
      <% unless @eyebrow.to_s.empty? %>
        <pre><code class="highlight"><%= @eyebrow %></code></pre>
      <% end %>
      <h2><%= @heading %></h2>
      <%= markdownify @intro %>
    </div>
    <%= render ListTable.new do %>
      <% @items.each do |item| %>
        <li>
          <span class="label"><%= item[:label] %></span>
          <span><%= raw markdownify(item[:body]).sub(/\A<p>/, "").sub(/<\/p>\s*\z/, "") %></span>
        </li>
      <% end %>
    <% end %>
    <% unless @note.to_s.empty? %>
      <%= raw markdownify(@note).sub(/\A<p>/, %(<p class="#{@note_class}">)) %>
    <% end %>
  </div>
</section>
