<section id="<%= @section_id %>">
  <div class="container">
    <div>
      <pre><code class="highlight"><%= @eyebrow %></code></pre>
      <h2><%= @heading %></h2>
    </div>
    <%= render Card.new(variant: "grid") do %>
      <% @features.each do |feature| %>
        <div>
          <pre><code class="highlight"><%= feature[:code] %></code></pre>
          <%= markdownify feature[:body] %>
        </div>
      <% end %>
    <% end %>
  </div>
</section>
